# Copy to .env; the backend loads the root .env on startup.
CAMO_ADDR=127.0.0.1:8080
DOCKER_HOST=unix:///var/run/docker.sock
# Panel login account; set a password of 8–72 bytes before starting.
CAMO_ADMIN_USERNAME=admin
CAMO_ADMIN_PASSWORD=
# Optional API credential for programmatic clients.
CAMO_API_TOKEN=
# Website & App Store data directory
CAMO_DATA_DIR=./data
# Built-in Nginx gateway ports
CAMO_NGINX_PORT=80
CAMO_NGINX_SSL_PORT=443
# Let's Encrypt default notification email
CAMO_ACME_EMAIL=admin@example.com

# Server file manager root (independent of Docker connectivity)
CAMO_FILES_ROOT=/
