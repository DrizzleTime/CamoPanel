{
  "name": "camopanel",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.3",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "bun scripts/dev.mjs",
    "dev:api": "cd backend && go run ./cmd/server",
    "dev:web": "bun run --cwd frontend dev",
    "build": "bun run --cwd frontend build && cd backend && go build -buildvcs=false -o ../bin/camopanel ./cmd/server",
    "test": "bun run test:web && bun run test:api",
    "test:web": "bun run --cwd frontend typecheck",
    "test:api": "cd backend && go test ./...",
    "test:ui": "bun run --cwd frontend test:ui"
  }
}
